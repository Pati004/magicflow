# =============================================================
#  MAGICFLOW — Environment Variables Template
#  Kopiraj v .env in zapolni vrednosti. NIKOLI ne commitaj .env!
# =============================================================

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Magicflow
NODE_ENV=development

# ─── Database (Prisma) ────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/magicflow?schema=public

# Shadow DB je potreben za Prisma migrations pri nekaterih providerjih
SHADOW_DATABASE_URL=postgresql://postgres:password@localhost:5432/magicflow_shadow?schema=public

# ─── Clerk (Avtentikacija) ────────────────────────────────────
# Najdeš na: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect poti
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk Webhook Secret (za sinhronizacijo user podatkov z DB)
# Najdeš na: Clerk Dashboard → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cloudinary (Nalaganje medijev) ───────────────────────────
# Najdeš na: https://console.cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary upload preset (nastavi na: Settings → Upload → Upload presets)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=magicflow_uploads

# ─── Zustand / Redis (opcijsko — za SSR state hydration) ──────
# Samo če uporabljaš Redis za server-side store
# UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email (opcijsko — Resend / Nodemailer) ───────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@magicflow.app

# ─── Analytics (opcijsko) ─────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ─── Sentry (opcijsko — error tracking) ──────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=magicflow
