// =============================================================
//  MAGICFLOW — Prisma Schema
//  Database: PostgreSQL (Prisma Postgres)
//  Generated: 2026
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────

/// Vloge uporabnikov v sistemu
enum Role {
  ADMIN     // Polni dostop — upravljanje platforme
  OPERATOR  // Dostop do dodeljenih projektov
}

/// Status seje fotografiranja
enum SessionStatus {
  ACTIVE    // Seja je v teku
  COMPLETED // Seja je zaključena
}

/// Podprti AI video modeli
enum VideoModel {
  RUNWAY  // Runway Gen-3
  KLING   // Kling AI
  LUMA    // Luma Dream Machine
  PIKA    // Pika Labs
}

/// Status generiranja videa
enum VideoStatus {
  PENDING    // Čaka v vrsti
  PROCESSING // V obdelavi pri AI modelu
  DONE       // Uspešno generirano
  ERROR      // Napaka pri generiranju
}

/// Podprti AI modeli za konfiguracijo projekta
enum AiModel {
  RUNWAY_GEN3
  KLING_V1
  KLING_V2
  LUMA_DREAM
  PIKA_V2
}

// ─── MODELI ───────────────────────────────────────────────────

/// Uporabnik platforme — sinhroniziran s Clerk avtentikacijo
model User {
  id        String   @id @default(cuid())
  /// Clerk zunanji ID (primarni identifikator iz auth sistema)
  clerkId   String   @unique
  email     String   @unique
  name      String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacije
  projects  Project[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
  @@map("users")
}

/// Projekt — osnovna enota platforme, pripada naročniku
model Project {
  id          String   @id @default(cuid())
  naziv       String
  /// URL-prijazen identifikator projekta (npr. "pepsi-promo-2026")
  slug        String   @unique
  narocnik    String
  opis        String?
  /// Splošne nastavitve projekta (poljubna JSON struktura)
  nastavitve  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacije
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  config      ProjectConfig?
  sessions    Session[]

  @@index([userId])
  @@index([slug])
  @@index([narocnik])
  @@index([createdAt])
  @@map("projects")
}

/// Konfiguracija projekta — 1:1 z Project, vsebuje branding in AI nastavitve
model ProjectConfig {
  id               String   @id @default(cuid())
  /// Branding nastavitve (logo, barve, pisave, ozadje...)
  branding         Json     @default("{}")
  /// Seznam vklopljenih funkcij (npr. ["printing", "email", "qr"])
  enabledFeatures  String[] @default([])
  /// Razpoložljivi čustveni stili videov (npr. ["dramatic", "playful", "elegant"])
  emotionalStyles  String[] @default([])
  /// Konfiguracija tiskalnika (model, papir, DPI...)
  printerConfig    Json     @default("{}")
  aiModel          AiModel  @default(RUNWAY_GEN3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relacije — 1:1 z Project
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_configs")
}

/// Seja — en obisk gosta na fotografski postaji
model Session {
  id          String        @id @default(cuid())
  /// Neobvezno ime gosta (za personalizacijo izkušnje)
  guestName   String?
  status      SessionStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relacije
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos      Photo[]

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("sessions")
}

/// Fotografija — posneta v okviru seje, shranjena na Cloudinary
model Photo {
  id                  String   @id @default(cuid())
  /// Javni URL fotografije na Cloudinary CDN
  cloudinaryUrl       String
  /// Cloudinary Public ID za upravljanje (brisanje, transformacije)
  cloudinaryPublicId  String   @unique
  /// Rezultat analize poze (keypoints, zaupanje, orientacija...)
  poseAnalysis        Json     @default("{}")
  createdAt           DateTime @default(now())

  // Relacije
  sessionId           String
  session             Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  generatedVideos     GeneratedVideo[]
  evalResults         EvalResult[]
  comparisonPairs     ComparisonPair[]

  @@index([sessionId])
  @@index([cloudinaryPublicId])
  @@index([createdAt])
  @@map("photos")
}

/// Generiran video — rezultat AI obdelave fotografije
model GeneratedVideo {
  id          String      @id @default(cuid())
  model       VideoModel
  /// Prompt poslan AI modelu za generiranje
  prompt      String      @db.Text
  status      VideoStatus @default(PENDING)
  /// Javni URL generiranega videa (null dokler ni DONE)
  videoUrl    String?
  /// Čas generiranja v milisekundah (za analytics)
  latencyMs   Int?
  /// Strošek generiranja v USD (za sledenje porabe)
  costUsd     Decimal?    @db.Decimal(10, 6)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relacije
  photoId     String
  photo       Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  rating      VideoRating?

  @@index([photoId])
  @@index([status])
  @@index([model])
  @@index([createdAt])
  @@map("generated_videos")
}

/// Ocena videa — subjektivna ocena kakovosti s strani operatorja ali gosta
model VideoRating {
  id               String   @id @default(cuid())
  /// Ujemanje z željenim stilom (1–5)
  styleMatch       Int
  /// Splošna kakovost videa (1–5)
  overallQuality   Int
  /// Ali je video kontekstualno ustrezen za priložnost
  isContextual     Boolean  @default(true)
  createdAt        DateTime @default(now())

  // Relacije — 1:1 z GeneratedVideo
  generatedVideoId String         @unique
  generatedVideo   GeneratedVideo @relation(fields: [generatedVideoId], references: [id], onDelete: Cascade)

  @@index([generatedVideoId])
  @@index([styleMatch])
  @@index([overallQuality])
  @@map("video_ratings")
}

// ─── EVALVACIJSKI MODUL ───────────────────────────────────────

/// Evalvacijska seja — skupina testnih generiranj za primerjavo modelov
model EvalSession {
  id          String       @id @default(cuid())
  /// Ime testnega nabora (npr. "Pilot RV1", "Batch Poroke T1")
  testSetName String
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  results     EvalResult[]

  @@index([createdAt])
  @@map("eval_sessions")
}

/// Posamezni rezultat generiranja videa v okviru evalvacije
model EvalResult {
  id            String      @id @default(cuid())
  /// Kateri AI model je bil uporabljen (npr. "RUNWAY_GEN3", "KLING_V2")
  model         String
  prompt        String      @db.Text
  /// Ali je video kontekstualno ustrezen za priložnost
  isContextual  Boolean     @default(true)
  latencyMs     Int?
  costUsd       Decimal?    @db.Decimal(10, 6)
  videoUrl      String?
  status        VideoStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  evalSessionId String
  evalSession   EvalSession @relation(fields: [evalSessionId], references: [id], onDelete: Cascade)
  photoId       String
  photo         Photo       @relation(fields: [photoId], references: [id])
  ratings       EvalRating[]

  @@index([evalSessionId])
  @@index([model])
  @@index([photoId])
  @@index([status])
  @@map("eval_results")
}

/// MOS ocena enega ocenjevalca za en video
model EvalRating {
  id               String     @id @default(cuid())
  /// Anonymiziran ID ocenjevalca (iz localStorage)
  raterAnonymousId String
  /// MOS kakovost slike/videa (1–5)
  mosQuality       Int
  /// MOS ujemanje s stilom (1–5)
  mosStyleMatch    Int
  createdAt        DateTime   @default(now())

  evalResultId     String
  evalResult       EvalResult @relation(fields: [evalResultId], references: [id], onDelete: Cascade)

  @@index([evalResultId])
  @@index([raterAnonymousId])
  @@map("eval_ratings")
}

// ─── PRIMERJAVA KONTEKSTUALNIH VS GENERIČNIH PROMPTOV (T2) ────

/// Seja primerjave — grupira pare za isti model in nabor fotografij
model PromptComparison {
  id        String           @id @default(cuid())
  name      String
  model     String
  notes     String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  pairs     ComparisonPair[]

  @@index([createdAt])
  @@map("prompt_comparisons")
}

/// En par: ista fotografija, kontekstualni prompt vs. generični prompt
model ComparisonPair {
  id                  String           @id @default(cuid())
  /// Indeks stila (0–4) za poravnavo med kontekstualnim in generičnim
  styleIndex          Int              @default(0)
  contextualPrompt    String           @db.Text
  genericPrompt       String           @db.Text
  genericPromptName   String           // npr. "Cinematic"
  contextualVideoUrl  String?
  genericVideoUrl     String?
  contextualStatus    VideoStatus      @default(PENDING)
  genericStatus       VideoStatus      @default(PENDING)
  contextualLatencyMs Int?
  genericLatencyMs    Int?
  contextualCostUsd   Decimal?         @db.Decimal(10, 6)
  genericCostUsd      Decimal?         @db.Decimal(10, 6)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  comparisonId        String
  comparison          PromptComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  photoId             String
  photo               Photo            @relation(fields: [photoId], references: [id])
  ratings             ComparisonRating[]

  @@index([comparisonId])
  @@index([photoId])
  @@map("comparison_pairs")
}

/// Ocena enega para — zbira preference in ujemanje za oba videa
model ComparisonRating {
  id               String         @id @default(cuid())
  raterAnonymousId String
  /// Ujemanje kontekstualnega videa s fotografijo (1–5)
  contextualFit    Int
  /// Ujemanje generičnega videa s fotografijo (1–5)
  genericFit       Int
  /// Kateri video je ocenjevalec preferiral
  preference       String         // "contextual" | "generic" | "equal"
  createdAt        DateTime       @default(now())

  pairId           String
  pair             ComparisonPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@unique([pairId, raterAnonymousId])
  @@index([pairId])
  @@index([raterAnonymousId])
  @@map("comparison_ratings")
}

// ─── SUS VPRAŠALNIK (T3) ──────────────────────────────────────

/// Seja za enega udeleženca — vsebuje JWT token za enkratni dostop
model SUSStudySession {
  id        String       @id @default(cuid())
  /// Oznaka serije (npr. "Batch 1 — Operator testi")
  label     String
  /// Podpisani JWT token (1-use only)
  token     String       @unique
  /// Ali je udeleženec že izpolnil vprašalnik
  used      Boolean      @default(false)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  response  SUSResponse?
  observation ObservationSession?

  @@index([token])
  @@index([used])
  @@map("sus_study_sessions")
}

/// Izpolnjen SUS vprašalnik — 10 odgovorov + izračunan score
model SUSResponse {
  id             String          @id @default(cuid())
  /// Starost udeleženca (opcijsko)
  participantAge Int?
  /// Tehnična izkušenost: "nizka" | "srednja" | "visoka"
  techExperience String?
  /// 10 odgovorov (1–5) v JSON polju
  answers        Json
  /// Izračunan SUS score (0–100)
  score          Float
  /// Slovenska oznaka: "Nesprejemljivo" | "Marginalno" | ... | "Odlično"
  grade          String
  createdAt      DateTime        @default(now())

  studySessionId String          @unique
  studySession   SUSStudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([createdAt])
  @@map("sus_responses")
}

// ─── GLASNO RAZMIŠLJANJE / OPAZOVANJE (T3) ───────────────────

/// Opazovalna seja — en udeleženec, en moderator
model ObservationSession {
  id              String    @id @default(cuid())
  /// Anonimna koda udeleženca (P01, P02...)
  participantCode String
  /// Neobvezna povezava na SUS sejo za korelacijo
  susSessionId    String?   @unique
  susSession      SUSStudySession? @relation(fields: [susSessionId], references: [id])
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  /// Splošne opombe moderatorja
  notes           String?   @db.Text
  events          ObservationEvent[]
  interview       InterviewResponse?

  @@index([participantCode])
  @@index([startedAt])
  @@map("observation_sessions")
}

/// Posamezna opazka/citat med sejo glasnega razmišljanja
model ObservationEvent {
  id                    String             @id @default(cuid())
  /// Tip opazke
  type                  String             // "confusion" | "error" | "positive" | "question" | "quote"
  /// Milisekunde od začetka seje
  timestampMs           Int
  /// Verbatim citat ali opis
  quote                 String?            @db.Text
  /// Kiosk wizard korak (welcome, camera, actions, style, generating, result)
  kioskStep             String?
  /// Tema za tematsko analizo (dodeli post-hoc)
  theme                 String?
  /// Podtema
  subtheme              String?
  createdAt             DateTime           @default(now())

  observationSessionId  String
  observationSession    ObservationSession @relation(fields: [observationSessionId], references: [id], onDelete: Cascade)

  @@index([observationSessionId])
  @@index([type])
  @@index([theme])
  @@map("observation_events")
}

/// Pol-strukturiran intervju po testni seji
model InterviewResponse {
  id                   String             @id @default(cuid())
  // ─── Sklop: Čakanje ────────────────────────────────────
  waitingFeelings      Int?               // 1–7
  waitingDuration      Int?               // 1–7 (zaznana dolžina)
  waitingNotes         String?            @db.Text
  // ─── Sklop: Video rezultat ──────────────────────────────
  videoDescription     String?            @db.Text
  wouldWatchAgain      Int?               // 1–7
  videoQuality         Int?               // 1–7
  videoNotes           String?            @db.Text
  // ─── Sklop: Primerjava stilov ───────────────────────────
  preferredStyle       String?
  wantsMoreOptions     Int?               // 1–7
  styleNotes           String?            @db.Text
  // ─── Regresija T4 ───────────────────────────────────────
  /// Skupna ocena izkušnje (1-7) -- odvisna spremenljivka T4
  overallSatisfaction  Int?
  /// Ocena intuitivnosti vmesnika (1-7)
  interfaceRating      Int?
  /// Izmerjen cas generiranja videa v ms (zapise moderator)
  totalLatencyMs       Int?
  // ─── Splošno ────────────────────────────────────────────
  generalNotes         String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  observationSessionId String             @unique
  observationSession   ObservationSession @relation(fields: [observationSessionId], references: [id], onDelete: Cascade)

  @@map("interview_responses")
}
